# Django
DEBUG=False
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1

# Postgres Render (données durables entre mises à jour)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_SSL_REQUIRE=True

# Médias durables (avatars, photos projets, pièces jointes)
# Sans cette variable, les fichiers uploadés peuvent disparaître à chaque redeploy.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Admin créé une seule fois au premier démarrage (jamais écrasé ensuite)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@appmwinda.com
ADMIN_PASSWORD=change-me-strong-password

SECURE_SSL_REDIRECT=True
